# App Environment
APP_ENV=development

# Folders and Paths (overrides default relative paths)
# CSV_PATH=database/quran_posts.csv
# USED_VERSES_PATH=database/used_verses.txt
# ASSETS_DIR=templates
# OUTPUT_DIR=output
# FONTS_DIR=fonts

# Rendering - Dimensions
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080
MARGIN_X=80
GAPS=20

# Rendering - Assets
BACKGROUND_IMAGE=background.jpg
LOGO_IMAGE=logo.png
SEPARATOR_IMAGE=separator.png

# Rendering - Fonts
ARABIC_FONT_NAME=_extracted_fonts/Amiri-Regular.ttf
ENGLISH_FONT_NAME=PlayfairDisplay-Regular.ttf
ARABIC_FONT_SIZE_BASE=72
TRANSLIT_FONT_SIZE_BASE=36
TRANS_FONT_SIZE_BASE=30
REF_FONT_SIZE_BASE=22

# Rendering - Colors (RGB)
BG_COLOR=245,244,240
BG_ALPHA=0.35
COLOR_ARABIC=10,10,10
COLOR_TRANSLIT=40,40,40
COLOR_TRANS=30,30,30
COLOR_REF=90,90,90
